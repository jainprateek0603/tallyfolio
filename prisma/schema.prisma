generator client {
  provider = "prisma-client-js"
}

// Local development uses SQLite. For PostgreSQL, run:
//   node scripts/set-db-provider.mjs postgresql
// Then point DATABASE_URL at Postgres and apply the schema with
// `npx prisma db push`. Do not replay the SQLite migration SQL.
// See DECISIONS.md.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
}

enum RecurringInterval {
  WEEKLY
  MONTHLY
}

enum ExpenseCategory {
  SOFTWARE
  TRAVEL
  CONTRACTOR
  SUPPLIES
  OTHER
}

model User {
  id                   String    @id @default(cuid())
  name                 String?
  email                String    @unique
  emailVerified        DateTime?
  passwordHash         String?
  image                String?
  role                 Role      @default(USER)
  plan                 Plan      @default(FREE)
  suspended            Boolean   @default(false)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String?
  currency             String    @default("USD")
  businessName         String?
  businessAddress      String?
  taxId                String?
  reminderEnabled      Boolean   @default(true)
  invoiceSequence      Int       @default(1000)
  taxLabel             String    @default("Tax")
  defaultTaxRateBps   Int       @default(0)
  hourlyRateCents      Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  clients      Client[]
  projects     Project[]
  tasks        Task[]
  invoices     Invoice[]
  reminderLogs ReminderLog[]
  schedules    RecurringSchedule[]
  timeEntries  TimeEntry[]
  expenses     Expense[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Client {
  id        String   @id @default(cuid())
  userId    String
  name      String
  email     String?
  company   String?
  phone     String?
  address   String?
  notes     String?
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects  Project[]
  invoices  Invoice[]
  schedules RecurringSchedule[]
  expenses  Expense[]

  @@index([userId])
  @@index([userId, name])
}

model Project {
  id          String        @id @default(cuid())
  userId      String
  clientId    String
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  budgetCents Int?
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  tasks     Task[]
  invoices  Invoice[]
  schedules RecurringSchedule[]
  timeEntries TimeEntry[]
  expenses  Expense[]

  @@index([userId])
  @@index([userId, status])
  @@index([clientId])
}

model Task {
  id          String       @id @default(cuid())
  userId      String
  projectId   String
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([projectId])
}

model Invoice {
  id         String        @id @default(cuid())
  userId     String
  clientId   String
  projectId  String?
  number     String
  status     InvoiceStatus @default(DRAFT)
  issueDate  DateTime
  dueDate    DateTime
  currency   String        @default("USD")
  taxRateBps Int           @default(0)
  notes         String?
  sentAt        DateTime?
  paidAt        DateTime?
  publicToken   String?       @unique
  viewCount     Int           @default(0)
  firstViewedAt DateTime?
  lastViewedAt  DateTime?
  lateFeeBps    Int           @default(0)
  lateFeeCents  Int           @default(0)
  scheduleId    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  client      Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project     Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  schedule    RecurringSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  items       InvoiceItem[]
  reminders   ReminderLog[]
  timeEntries TimeEntry[]

  @@unique([userId, number])
  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, paidAt])
  @@index([clientId])
  @@index([scheduleId])
}

model ProcessedStripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

model InvoiceItem {
  id                 String @id @default(cuid())
  invoiceId          String
  description        String
  quantityHundredths Int
  unitCents          Int
  sortOrder          Int    @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model ReminderLog {
  id        String         @id @default(cuid())
  userId    String
  invoiceId String
  sentOn    DateTime
  status    ReminderStatus @default(PENDING)
  error     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, sentOn])
  @@index([userId])
}

model RecurringSchedule {
  id         String            @id @default(cuid())
  userId     String
  clientId   String
  projectId  String?
  interval   RecurringInterval
  nextRunOn  DateTime
  active     Boolean           @default(true)
  taxRateBps Int               @default(0)
  lateFeeBps Int               @default(0)
  dueDays    Int               @default(14)
  currency   String
  notes      String?
  lastError  String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project  Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items    RecurringItem[]
  invoices Invoice[]

  @@index([userId, active])
  @@index([nextRunOn])
}

model RecurringItem {
  id                 String @id @default(cuid())
  scheduleId         String
  description        String
  quantityHundredths Int
  unitCents          Int
  sortOrder          Int    @default(0)

  schedule RecurringSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
}

model TimeEntry {
  id          String    @id @default(cuid())
  userId      String
  projectId   String
  description String?
  startedAt   DateTime
  endedAt     DateTime?
  invoiceId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([projectId])
  @@index([invoiceId])
}

model Expense {
  id          String          @id @default(cuid())
  userId      String
  clientId    String?
  projectId   String?
  category    ExpenseCategory @default(OTHER)
  description String
  amountCents Int
  currency    String
  incurredOn  DateTime
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, incurredOn])
}
