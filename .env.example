# SQLite file, relative to the prisma/ directory.
DATABASE_URL="file:./dev.db"

# Generate a long random string. This example value is a placeholder, not a secret to reuse.
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"
# Set to true for local dev, Vercel, and any host behind a reverse proxy.
AUTH_TRUST_HOST="true"

# Optional Google sign-in. Leave blank to use email and password only.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_ENABLED="false"

# Stripe test mode. Leave blank until you want Checkout.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Bearer token for POST /api/cron/reminders
CRON_SECRET="replace-with-a-long-random-string"

# console logs mail. Set to resend and provide a key to send.
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="invoices@example.com"

# Requests per 15 minutes for register and credentials sign-in.
AUTH_RATE_LIMIT="10"

# Optional. When set, unhandled API errors are also posted to Sentry's store API.
SENTRY_DSN=""

# Optional model. Leave AI_API_KEY blank to draft invoices and reminders locally.
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
